<Window x:Class="LatencyTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LatencyTester"
        Title="ASIO 延迟检测"
        Width="1600"
        Height="820"
        MinWidth="1260"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="600" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" FontSize="24" FontWeight="SemiBold" Text="ASIO 延迟检测" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,18" Foreground="#666"
                   Text="选择本机 ASIO 驱动后，先测量声卡直连基准，再接入效果器板测量实际延迟。" TextWrapping="Wrap" />

        <GroupBox Grid.Row="2" Grid.Column="0" Header="最近一次测试波形" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:WaveformPlot x:Name="WaveformPlot" Grid.Row="0" MinWidth="580" MinHeight="420" />
                <ScrollBar x:Name="WaveformScrollBar" Grid.Row="1" Height="18" Margin="0,8,0,0"
                           Orientation="Horizontal" Minimum="0" Maximum="1" ViewportSize="1"
                           Visibility="Collapsed" IsEnabled="False" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Grid.Column="2" Header="ASIO 设备" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DriverComboBox" Width="470" DisplayMemberPath="Name" />
                    <Button Margin="10,0,0,0" Padding="14,4" Click="RefreshButton_Click" Content="刷新" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,14,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="采样率:" />
                    <ComboBox x:Name="SampleRateComboBox" Width="130" Margin="8,0,18,0"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock VerticalAlignment="Center" Text="Buffer size:" />
                    <ComboBox x:Name="BufferSizeComboBox" Width="130" Margin="8,0,0,0"
                              DisplayMemberPath="DisplayName"
                              ToolTip="选择本次测量使用的 ASIO buffer size" />
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="输出通道:" />
                    <ComboBox x:Name="OutputChannelComboBox" Width="460" Margin="8,0,0,0"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="输入通道:" />
                    <ComboBox x:Name="InputChannelComboBox" Width="460" Margin="8,0,0,0"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>
                <TextBox x:Name="DetailsTextBox" Grid.Row="4" IsReadOnly="True"
                         AcceptsReturn="True" Background="#FAFAFA" BorderThickness="1"
                         FontFamily="Consolas" IsReadOnlyCaretVisible="False"
                         MinHeight="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                <StackPanel Grid.Row="5" Margin="0,12,0,0" Orientation="Horizontal">
                    <Button x:Name="MeasureBaselineButton" Padding="14,4" Click="MeasureBaselineButton_Click"
                            Content="测量声卡直连基准" />
                    <Button x:Name="MeasureEffectButton" Margin="10,0,0,0" Padding="14,4"
                            Click="MeasureEffectButton_Click" Content="测量效果器回路" />
                </StackPanel>
                <TextBlock x:Name="BaselineTextBlock" Grid.Row="6" Margin="0,10,0,0"
                           Foreground="#666" Text="尚未记录声卡直连基准" />
            </Grid>
        </GroupBox>

        <StatusBar Grid.Row="3" Grid.ColumnSpan="3" Margin="0,18,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="正在加载 ASIO 驱动..." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
